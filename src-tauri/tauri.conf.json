{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aether-api",
  "version": "0.1.0",
  "identifier": "com.hephaestus-studio.aether-api",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "welcome",
        "title": "Welcome to AetherAPI",
        "width": 800,
        "height": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "AetherAPI",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
