{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether API",
  "version": "0.2.0-beta.3",
  "identifier": "com.hephaestus-studio.aether-api",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "welcome",
        "title": "Welcome to Aether API",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": true,
        "transparent": true
      },
      {
        "label": "main",
        "title": "Aether API",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Next-generation local-first and git-centric API client",
    "longDescription": "Aether API is an open-source, local-first, git-centric, and privacy-focused API client for developers with embedded terminal, Monaco editor, and on-device encryption.",
    "copyright": "Copyright © 2026 Hephaestus Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
